{
  "manifest_version": 3,
  "name": "TokenStockMonitor - Coding Plan 补货提醒",
  "version": "1.0.0",
  "description": "监控 GLM Coding Plan 与 Kimi Code Plan 的套餐状态变化，状态改变时通过企业微信群机器人提醒。仅提醒，不抢购、不下单。",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://bigmodel.cn/*",
    "https://*.bigmodel.cn/*",
    "https://www.kimi.com/*",
    "https://*.kimi.com/*",
    "https://qyapi.weixin.qq.com/*",
    "https://api.day.app/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bigmodel.cn/glm-coding*",
        "https://*.bigmodel.cn/glm-coding*"
      ],
      "js": ["src/content-glm.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Coding Plan 补货提醒",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
